# ===== SERVER =====
PORT=3000

# Database configuration
DB_HOST=localhost
DB_USER=user_name
DB_PASSWORD=user_password
DB_NAME=database_name
DB_PORT=3306

# ===== GROQ AI =====
GROQ_API_KEY=your_groq_api_key

# Modelo por ambiente:
#   Local  → llama-3.3-70b-versatile   (rápido, sem custo extra)
#   Vercel → openai/gpt-oss-20b        (raciocínio avançado)
GROQ_MODEL=llama-3.3-70b-versatile

# reasoning_effort para chatbot em modelos openai/* (low | medium | high)
# Apenas necessário no Vercel com GROQ_MODEL=openai/gpt-oss-*
# GROQ_REASONING_EFFORT=low
