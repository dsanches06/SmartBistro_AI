# ===== SERVER =====
PORT=3000

# PostgreSQL / Neon (local or production)
# DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require&channel_binding=require

# Database configuration (local MySQL)
DB_HOST=localhost
DB_USER=user_name
DB_PASSWORD=user_password
DB_NAME=database_name
DB_PORT=3306

# ===== AUTH =====
JWT_SECRET=change_this_to_a_long_random_secret

# ===== CLAUDE AI (chatbot, agentes Maître/Chef/Cashier/Analytics) =====
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_MODEL=claude-haiku-4-5

# ===== GROQ AI (usado apenas para transcrição de voz — Whisper) =====
GROQ_API_KEY=your_groq_api_key
